<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Mixed everyday T2 camp (normal biomes only). No Pen (keeps corn/hay optional elsewhere). -->
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Generic_T2_Camp</defName>
    <settlementSize>64,64</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>

    <centerBuildings>
      <centralBuildingTags>
        <li>Generic_Production</li>
      </centralBuildingTags>
      <centerSize>56,56</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_VanguardBarracks</tag>
          <count>1~2</count>
        </li>
        <li>
          <tag>Generic_Bedroom</tag>
          <count>1~2</count>
        </li>
        <li>
          <tag>Generic_Production</tag>
          <count>0~2</count>
        </li>
        <li>
          <tag>Generic_Stockpile</tag>
          <count>1~2</count>
        </li>
        <li>
          <tag>TSA_Tribal_Farm</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>TSA_Tribal_Mining</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Generic_Recreation</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Kitchen</tag>
          <count>0~1</count>
        </li>
      </allowedStructures>
    </centerBuildings>

    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Generic_Barricade</tag>
          <count>3~6</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>

    <defenseOptions>
      <pawnGroupMultiplier>0.7</pawnGroupMultiplier>
    </defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>8</scatterMaxAmount>
      <scatterPropsDefs>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_Planks</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_Pallet</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_BarrelGreen</li>
        <li>TSA_WD_Box_1a</li>
        <li>TSA_WD_Box_2a</li>
        <li>TSA_WD_Box_3a</li>
        <li>TSA_WD_Box_4a</li>
        <li>TSA_WD_Box_5a</li>
        <li>TSA_WD_BoxPallet_1a</li>
        <li>TSA_WD_BoxPallet_2a</li>
        <li>TSA_WD_BoxPallet_3a</li>
        <li>TSA_WD_Cart_5a</li>
        <li>TSA_WD_Cart_6a</li>
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>

    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
  </KCSG.SettlementLayoutDef>
</Defs>
