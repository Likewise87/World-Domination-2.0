<?xml version="1.0" encoding="utf-8" ?>
<!-- BoR-only outposts. Loaded via loadFolders IfModActive bambaryla.bor / bambaryla.bor.redux. -->
<Defs>
<WorldObjectDef ParentName="TSA_WD_Outpost_SimpleProduction">
        <defName>BOR_TSA_WD_Outpost_DrugLab</defName>
        <label>Advanced Drug Lab Outpost</label>
        <texture>WorldObjects/Outposts/SO_Drug</texture>
        <expandingIconTexture>WorldObjects/Outposts/SO_Drug</expandingIconTexture>
        <modExtensions>
            <li Class="TSA_WorldDomination.OutpostDefExtension, TSA_WorldDomination">
                <outpostTier>3</outpostTier>
                <minPawnsToFound>1</minPawnsToFound>
                <requiredResearchProjectDefNames>
                    <li>BOR_Research_Drugs_I</li>
                </requiredResearchProjectDefNames>
                <MinCumulativeSkill>
                    <li>
                        <Intellectual>15</Intellectual>
                    </li>
                </MinCumulativeSkill>
                <establishmentCost>
                    <BOR_Sunsteel>100</BOR_Sunsteel>
                    <ComponentSpacer>8</ComponentSpacer>
                </establishmentCost>
                <productionCycleDays>20</productionCycleDays>
                <productionOptions>
                    <li>
                        <thingDef>BOR_Sunlite</thingDef>
                        <amountPerSkillLevel>2</amountPerSkillLevel>
                        <minSkillLevel>12</minSkillLevel>
                    </li>
                    <li>
                        <thingDef>BOR_Trot</thingDef>
                        <amountPerSkillLevel>3</amountPerSkillLevel>
                        <minSkillLevel>14</minSkillLevel>
                    </li>
                    <li>
                        <thingDef>BOR_Aegis</thingDef>
                        <amountPerSkillLevel>2</amountPerSkillLevel>
                        <minSkillLevel>15</minSkillLevel>
                    </li>
                    <li>
                        <thingDef>BOR_WideAWake</thingDef>
                        <amountPerSkillLevel>3</amountPerSkillLevel>
                        <minSkillLevel>15</minSkillLevel>
                    </li>
                    <li>
                        <thingDef>BOR_Canter</thingDef>
                        <amountPerSkillLevel>2</amountPerSkillLevel>
                        <minSkillLevel>12</minSkillLevel>
                        <requiredResearch>BOR_Research_Drugs_II</requiredResearch>
                    </li>
                    <li>
                        <thingDef>BOR_Castra</thingDef>
                        <amountPerSkillLevel>3</amountPerSkillLevel>
                        <minSkillLevel>14</minSkillLevel>
                        <requiredResearch>BOR_Research_Drugs_II</requiredResearch>
                    </li>
                    <li>
                        <thingDef>BOR_Sleepquitin</thingDef>
                        <amountPerSkillLevel>2</amountPerSkillLevel>
                        <minSkillLevel>15</minSkillLevel>
                        <requiredResearch>BOR_Research_Drugs_II</requiredResearch>
                    </li>
                    <li>
                        <thingDef>BOR_Sunlight</thingDef>
                        <amountPerSkillLevel>3</amountPerSkillLevel>
                        <minSkillLevel>15</minSkillLevel>
                        <requiredResearch>BOR_Research_Drugs_II</requiredResearch>
                    </li>
