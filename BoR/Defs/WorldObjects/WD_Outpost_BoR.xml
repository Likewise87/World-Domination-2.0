            </li>
        </modExtensions>
    </WorldObjectDef>

    <!-- Fabrication -->
    <WorldObjectDef ParentName="TSA_WD_Outpost_SimpleProduction">
        <defName>BOR_TSA_WD_Outpost_Fabrication</defName>
        <label>Advanced Fabrication Outpost</label>
        <texture>WorldObjects/Outposts/BOR_Factory</texture>
        <expandingIconTexture>WorldObjects/Outposts/BOR_Factory</expandingIconTexture>
        <modExtensions>
            <li Class="TSA_WorldDomination.OutpostDefExtension, TSA_WorldDomination">
                <outpostTier>3</outpostTier>
                <minPawnsToFound>2</minPawnsToFound>
                <requiredResearchProjectDefNames>
                    <li>BOR_Research_Production_I</li>
                </requiredResearchProjectDefNames>
                <MinCumulativeSkill>
                    <li>
                        <Crafting>15</Crafting>
                    </li>
                </MinCumulativeSkill>
                <establishmentCost>
                    <BOR_Sunsteel>300</BOR_Sunsteel>
                    <ComponentSpacer>10</ComponentSpacer>
