<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Tribal_T4_Vanguard</defName>
	<settlementSize>128,128</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    <centerBuildings Inherit="False">
	  <centralBuildingTags>
        <li>TSA_Tribal_VanguardBarracks</li>
      </centralBuildingTags>
      <centerSize>120,120</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <count>6~12</count>
          <tag>TSA_Tribal_VanguardBarracks</tag>
        </li>
        <li>
          <count>3~7</count>
          <tag>TSA_Tribal_BigBarracks</tag>
        </li>
        <li>
          <count>4~7</count>
          <tag>TSA_Tribal_Stockpile</tag>
        </li>
        <li>
          <tag>TribalKitchen</tag>
          <count>0~2</count>
        </li>
		
</allowedStructures>
    </centerBuildings>
	    <peripheralBuildings>
      <allowedStructures>
		<li>
          <tag>TSA_Generic_Barricade</tag>
          <count>32~56</count>
        </li>
        <li>
          <count>2~6</count>
          <tag>Generic_HeavyDefence</tag>
        </li>
        <li>
          <count>1~3</count>
          <tag>Generic_Mortar</tag>
        </li>
      </allowedStructures>
    </peripheralBuildings>
    <defenseOptions>
      <pawnGroupMultiplier>1.8</pawnGroupMultiplier>
    </defenseOptions>
    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>8</scatterMinDistance>
      <scatterMaxAmount>12</scatterMaxAmount>
      <scatterPropsDefs>
        <li>TSA_WD_Hayball_3a</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_WoodenLogs</li>
        <li>TSA_WD_Box_2a</li>
        <li>TSA_WD_Box_4a</li>
        <li>TSA_WD_Cart_5a</li>
        <li>TSA_WD_Cart_6a</li>
        <li>TSA_WD_Cart_7a</li>
        <li>TSA_WD_Cart_8a</li>
        <li>TSA_WD_Cart_9a</li>
        <li>TSA_WD_Cart_10a</li>
        <li>TSA_WD_Cart_11a</li>
        <li>TSA_WD_Cart_12a</li>



      
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>
    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
</KCSG.SettlementLayoutDef>
 </Defs>
