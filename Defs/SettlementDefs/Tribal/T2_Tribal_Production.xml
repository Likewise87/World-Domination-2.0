<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Tribal_T2_Production</defName>
    <settlementSize>64,64</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    
    <centerBuildings>
      <centralBuildingTags>
        <li>TSA_Tribal_Production</li>
      </centralBuildingTags>
      <centerSize>56,56</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_Barracks</tag>
          <count>1~3</count>
        </li>
        <li>
          <tag>TSA_Tribal_Stockpile</tag>
          <count>0~2</count>
        </li>
        <li>
          <tag>TSA_Tribal_Production</tag>
          <count>1~2</count>
        </li>
        <li>
          <count>0~1</count>
          <tag>TSA_Tribal_Recreation</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Graveyard</tag>
        </li>
        <li>
          <tag>TSA_Pen</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>TribalKitchen</tag>
          <count>0~1</count>
        </li>
</allowedStructures>
    </centerBuildings>

    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_Barricade</tag>
          <count>1~3</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>

    <defenseOptions>
      <pawnGroupMultiplier>0.75</pawnGroupMultiplier>
    </defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>8</scatterMaxAmount>
      <scatterPropsDefs>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_Planks</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_Pallet</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_BarrelGreen</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_FilthDirt</li>
        <li>TSA_WD_Box_1a</li>
        <li>TSA_WD_Box_2a</li>
        <li>TSA_WD_Box_5a</li>
        <li>TSA_WD_Cart_5a</li>




      
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>

    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
</KCSG.SettlementLayoutDef>
</Defs>
