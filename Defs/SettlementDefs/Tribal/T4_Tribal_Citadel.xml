<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Tribal_T4_Citadel</defName>
	<settlementSize>128,128</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    <centerBuildings Inherit="False">
	  <centralBuildingTags>
        <li>TSA_Tribal_BigBarracks</li>
      </centralBuildingTags>
      <centerSize>120,120</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <count>1~6</count>
          <tag>TSA_Tribal_Barracks</tag>
        </li>
        <li>
          <count>2~5</count>
          <tag>TSA_Tribal_Production</tag>
        </li>
		<li>
          <count>1~5</count>
          <tag>TSA_Tribal_Stockpile</tag>
        </li>
        <li>
          <count>1~4</count>
          <tag>TSA_Tribal_Slavery</tag>
        </li>
        <li>
          <count>1~3</count>
          <tag>TSA_Tribal_BigBarracks</tag>
        </li>
		<li>
          <count>0~3</count>
          <tag>TSA_Tribal_Mining</tag>
        </li>
        <li>
          <count>1~3</count>
          <tag>TSA_Tribal_Recreation</tag>
        </li>
        <li>
          <count>1~2</count>
          <tag>TSA_Tribal_Defence</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Graveyard</tag>
        </li>
		<li>
          <tag>TSA_Pen</tag>
          <count>0~1</count>
        </li>
		
</allowedStructures>
    </centerBuildings>
	    <peripheralBuildings>
      <allowedStructures>
		<li>
          <tag>TSA_Generic_Barricade</tag>
          <count>32~56</count>
        </li>

		<li>
          <count>2~6</count>
          <tag>Generic_HeavyDefence</tag>
        </li>
      </allowedStructures>
    </peripheralBuildings>
    <defenseOptions>
      <pawnGroupMultiplier>3.2</pawnGroupMultiplier>
    </defenseOptions>
    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>
    <stockpileOptions>
      <stockpileValueMultiplier>4.0</stockpileValueMultiplier>
      <fillStorageBuildings>true</fillStorageBuildings>
      <fillWithDefs>
        <li>Plasteel</li>
        <li>ComponentSpacer</li>
        <li>Uranium</li>
        <li>Gold</li>
        <li>ComponentIndustrial</li>
      </fillWithDefs>
    </stockpileOptions>
  </KCSG.SettlementLayoutDef>
 </Defs>