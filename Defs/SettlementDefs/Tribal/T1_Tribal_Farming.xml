<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Tribal_T1_Farming</defName>
    <settlementSize>52,52</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    
    <centerBuildings>
      <centerSize>44,44</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_BigBarracks</tag>
          <count>1~1</count>
        </li>
        <li>
          <tag>TSA_Tribal_Barracks</tag>
          <count>0~1</count>
        </li>
        <li>
          <count>4~7</count>
          <tag>TSA_Tribal_Farm</tag>
        </li>
      </allowedStructures>
    </centerBuildings>

    <defenseOptions>
      <pawnGroupMultiplier>0.35</pawnGroupMultiplier>
    </defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>7</scatterMaxAmount>
      <scatterPropsDefs>
        <li>TSA_WD_Hayball_2a</li>
        <li>TSA_WD_Hayball_3a</li>
        <li>TSA_WD_Hayball_4a</li>
        <li>TSA_WD_Hayball_5a</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_HayBaleLarge</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_HayBaleMedium</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_HayBaleSmall</li>
        <li>TSA_WD_Box_1a</li>
        <li>TSA_WD_Box_2a</li>


      
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>

    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
</KCSG.SettlementLayoutDef>
</Defs>
