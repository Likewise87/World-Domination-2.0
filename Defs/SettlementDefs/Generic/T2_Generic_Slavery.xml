<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Generic_T2_Slavery</defName>
    <settlementSize>64,64</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    
    <centerBuildings>
      <centralBuildingTags>
        <li>Generic_Prison_T1</li>
      </centralBuildingTags>
      <centerSize>56,56</centerSize>
      <spaceAround>1</spaceAround>
      <allowedStructures>
        <li>
          <tag>Generic_Throne</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Generic_Bedroom</tag>
          <count>1~2</count>
        </li>
        <li>
          <tag>Generic_Luxury_Bedroom</tag>
          <count>0~1</count>
        </li>
        <li>
          <count>0~1</count>
          <tag>TSA_Tribal_Recreation</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Recreation</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Tavern</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Graveyard</tag>
        </li>
        <li>
          <tag>TSA_Pen</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>TSA_ParkingLot</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Kitchen</tag>
          <count>0~1</count>
        </li>
</allowedStructures>
    </centerBuildings>

    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Generic_Barricade</tag>
          <count>3~8</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>

	<defenseOptions>
		<pawnGroupMultiplier>0.75</pawnGroupMultiplier>
	</defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>6</scatterMaxAmount>
      <scatterPropsDefs>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_FilthDirt</li>
        <li>TSA_WD_Box_2a</li>
        <li>TSA_WD_Box_4a</li>


      
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>

    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
</KCSG.SettlementLayoutDef>
</Defs>
