<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <KCSG.SettlementLayoutDef>
    <defName>TSA_Generic_T1_Mining</defName>
    <settlementSize>52,52</settlementSize>
    <avoidBridgeable>true</avoidBridgeable>
    <avoidMountains>true</avoidMountains>
    
    <centerBuildings>
      <centerSize>44,44</centerSize>
      <spaceAround>1</spaceAround>
	  <centralBuildingTags>
        <li>TSA_Tribal_Mining</li>
      </centralBuildingTags>
      <allowedStructures>
        <li>
          <tag>Generic_Bedroom</tag>
          <count>0~1</count>
        </li>
        <li>
          <tag>Generic_Stockpile</tag>
          <count>0~1</count>
        </li>
        <li>
          <count>1~3</count>
          <tag>TSA_Tribal_Mining</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>Generic_Mine</tag>
        </li>
        <li>
          <count>0~1</count>
          <tag>TSA_Tribal_BigBarracks</tag>
        </li>
        <li>
          <tag>Kitchen</tag>
          <count>0~1</count>
        </li>
      </allowedStructures>
    </centerBuildings>

    <peripheralBuildings>
      <allowedStructures>
        <li>
          <tag>TSA_Tribal_Barricade</tag>
          <count>2~4</count>
        </li>
      </allowedStructures>
    </peripheralBuildings>

    <defenseOptions>
      <pawnGroupMultiplier>0.35</pawnGroupMultiplier>
    </defenseOptions>

    <propsOptions>
      <scatterProps>true</scatterProps>
      <scatterMinDistance>5</scatterMinDistance>
      <scatterMaxAmount>5</scatterMaxAmount>
      <scatterPropsDefs>
        <li>TSA_WD_Wagon_1a</li>
        <li>TSA_WD_Wagon_2a</li>
        <li>TSA_WD_Wagon_3a</li>
        <li>TSA_WD_Wagon_5a</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_BrickPile</li>
        <li MayRequire="VanillaExpanded.VFEPropsandDecor">VFEPD_BarrelGreen</li>
        <li>TSA_WD_Box_3a</li>
        <li>TSA_WD_Box_4a</li>


      
      </scatterPropsDefs>
    </propsOptions>

    <roadOptions>
      <addLinkRoad>true</addLinkRoad>
      <linkRoadDef>PackedDirt</linkRoadDef>
    </roadOptions>

    <stockpileOptions>
      <fillStorageBuildings>false</fillStorageBuildings>
    </stockpileOptions>
</KCSG.SettlementLayoutDef>
</Defs>
