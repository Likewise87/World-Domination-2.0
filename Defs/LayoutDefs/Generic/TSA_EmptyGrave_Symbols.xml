<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    KCSG SymbolDef.chanceToContainPawn defaults to 1. Auto-created Grave symbols
    therefore always spawn a corpse. These defs override the rotated layout names
    used by Generic_Graveyard_* so graves spawn empty.
  -->
  <KCSG.SymbolDef>
    <defName>Grave_North</defName>
    <thing>Grave</thing>
    <rotation>North</rotation>
    <chanceToContainPawn>0</chanceToContainPawn>
  </KCSG.SymbolDef>

  <KCSG.SymbolDef>
    <defName>Grave_East</defName>
    <thing>Grave</thing>
    <rotation>East</rotation>
    <chanceToContainPawn>0</chanceToContainPawn>
  </KCSG.SymbolDef>

  <KCSG.SymbolDef>
    <defName>Grave_South</defName>
    <thing>Grave</thing>
    <rotation>South</rotation>
    <chanceToContainPawn>0</chanceToContainPawn>
  </KCSG.SymbolDef>

  <KCSG.SymbolDef>
    <defName>Grave_West</defName>
    <thing>Grave</thing>
    <rotation>West</rotation>
    <chanceToContainPawn>0</chanceToContainPawn>
  </KCSG.SymbolDef>

</Defs>
