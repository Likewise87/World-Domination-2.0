<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- World-map combat oneshots. Clips live under Sounds/*.ogg. Quiet camera grains. -->

  <SoundDef>
    <defName>TSA_WD_AT_Turret_Fire_Light</defName>
    <context>WorldOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>AT_Light</clipPath>
          </li>
        </grains>
        <volumeRange>12~18</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

