<!-- Special Logic Outposts -->
  <!-- Farming -->
  <WorldObjectDef ParentName="TSA_WD_Outpost">
    <defName>TSA_WD_Outpost_Farming</defName>
    <label>Farming Outpost</label>
    <texture>WorldObjects/WD_Outpost_Farming</texture>
    <expandingIconTexture>WorldObjects/WD_Outpost_Farming</expandingIconTexture>
    <modExtensions>
      <li Class="TSA_WorldDomination.OutpostDefExtension, TSA_WorldDomination">
        <outpostTier>1</outpostTier>
        <minPawnsToFound>1</minPawnsToFound>
        <minFertilityPercent>15</minFertilityPercent>
        <disallowedBiomes><li>Desert</li></disallowedBiomes>
        <MinCumulativeSkill>
          <li><Plants>5</Plants></li>
        </MinCumulativeSkill>
        <establishmentCost>
          <WoodLog>100</WoodLog>
        </establishmentCost>
        <productionCycleDays>20</productionCycleDays>
      </li>
    </modExtensions>
  </WorldObjectDef>
  
