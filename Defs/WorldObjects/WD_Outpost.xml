<!-- Simple Production Logic -->
 
  <!-- Fabrication -->
  <WorldObjectDef ParentName="TSA_WD_Outpost_SimpleProduction">
    <defName>TSA_WD_Outpost_Fabrication</defName>
    <label>Fabrication Outpost</label>
    <texture>WorldObjects/WD_Outpost_Fabrication</texture>
    <expandingIconTexture>WorldObjects/WD_Outpost_Fabrication</expandingIconTexture>
    <modExtensions>
      <li Class="TSA_WorldDomination.OutpostDefExtension, TSA_WorldDomination">
        <outpostTier>3</outpostTier>
        <minPawnsToFound>1</minPawnsToFound>
        <requiredResearchProjectDefNames>
          <li>Fabrication</li>
        </requiredResearchProjectDefNames>
        <MinCumulativeSkill>
          <li><Crafting>5</Crafting></li>
        </MinCumulativeSkill>
        <establishmentCost>
          <WoodLog>100</WoodLog>
          <ComponentIndustrial>4</ComponentIndustrial>
          <ComponentSpacer>2</ComponentSpacer>
        </establishmentCost>
        <productionCycleDays>20</productionCycleDays>
        <productionOptions>
          <li><thingDef>ComponentIndustrial</thingDef><amountPerSkillLevel>1</amountPerSkillLevel><minSkillLevel>7</minSkillLevel></li>
          <li><thingDef>ComponentSpacer</thingDef><amountPerSkillLevel>0.3</amountPerSkillLevel><minSkillLevel>12</minSkillLevel><requiredResearch>AdvancedFabrication</requiredResearch></li>
        </productionOptions>
      </li>
    </modExtensions>
  </WorldObjectDef>
  
    <!-- BiofuelRefinery -->
