<?xml version="1.0" encoding="utf-8" ?>
<!--
  1.7-only (loadFolders 1.7/Patches). Fair outpost power demand vs 1000 W plant + unpoweredOutputFactor.
  Do NOT put powerDemandWatts / unpoweredOutputFactor in Common/Defs/ — frozen 1.6 DLL has no such fields.
  Each op is its own root Conditional (not Always-Sequence) so one failed match cannot abort later defs.
  Soft default unpoweredOutputFactor is 0.75 (C#); heavy/military set 0.5 explicitly.
-->
<Patch>
  <!-- Soft extractive: 250 W / 0.75 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/WorldObjectDef[defName="TSA_WD_Outpost_Farming"]</xpath>
    <match Class="PatchOperationInsert">
    <xpath>/Defs/WorldObjectDef[defName="TSA_WD_Outpost_Farming"]/modExtensions/li[contains(@Class,'OutpostDefExtension')]/outpostTier</xpath>
    <order>Append</order>
    <value>
    <powerDemandWatts>250</powerDemandWatts>
    <unpoweredOutputFactor>0.75</unpoweredOutputFactor>
    </value>
    </match>
    </Operation>
