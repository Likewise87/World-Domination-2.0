<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- 1.7-only: Intel lives under Stats (Main Stats / Intel panes). Remove legacy standalone Intel tabs if present. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/WorldObjectDef[@Name="StaticWorldObjectBase"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_SettlementIntel, TSA_WorldDomination"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/WorldObjectDef[@Name="StaticWorldObjectBase"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_SettlementIntel, TSA_WorldDomination"]</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_Outpost"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_SettlementIntel, TSA_WorldDomination"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_Outpost"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_SettlementIntel, TSA_WorldDomination"]</xpath>
    </match>
  </Operation>
</Patch>
