      <xpath>/Defs/TSA_WorldDomination.OutpostUpgradeDef[defName="TSA_WD_Upgrade_ImprovedWatchTower"]</xpath>
      <value>
        <losBonusTiles>15</losBonusTiles>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TSA_WorldDomination.OutpostUpgradeDef[defName="TSA_WD_Upgrade_AdvancedWatchTower"]</xpath>
