<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Hunting Watch Tower line: flat FoW LOS bonus (1.7 OutpostUpgradeDef.losBonusTiles). -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TSA_WorldDomination.OutpostUpgradeDef[defName="TSA_WD_Upgrade_WoodenWatchTower"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TSA_WorldDomination.OutpostUpgradeDef[defName="TSA_WD_Upgrade_WoodenWatchTower"]</xpath>
      <value>
        <losBonusTiles>10</losBonusTiles>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TSA_WorldDomination.OutpostUpgradeDef[defName="TSA_WD_Upgrade_ImprovedWatchTower"]</xpath>
