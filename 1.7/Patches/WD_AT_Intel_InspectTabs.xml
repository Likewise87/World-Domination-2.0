<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- 1.7-only: AT Stats tab hosts Main Stats / Intel panes (WITab_OutpostAndSettlement_Stats). -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_AT_TurretBase"]/inspectorTabs</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_AT_TurretBase"]</xpath>
      <value>
        <inspectorTabs>
          <li>TSA_WorldDomination.WITab_OutpostAndSettlement_Stats, TSA_WorldDomination</li>
        </inspectorTabs>
      </value>
    </nomatch>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationRemove">
          <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_AT_TurretBase"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_AT_Intel, TSA_WorldDomination"]</xpath>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_AT_TurretBase"]/inspectorTabs/li[text()="TSA_WorldDomination.WITab_OutpostAndSettlement_Stats, TSA_WorldDomination"]</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/WorldObjectDef[@Name="TSA_WD_AT_TurretBase"]/inspectorTabs</xpath>
            <value>
              <li>TSA_WorldDomination.WITab_OutpostAndSettlement_Stats, TSA_WorldDomination</li>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
