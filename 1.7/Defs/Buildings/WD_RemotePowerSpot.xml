<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- Colony-map generator: power plant outpost watts enter via CompPowerTrader.PowerOutput. 1.7-only. -->
  <ThingDef ParentName="BuildingBase">
    <defName>TSA_WD_RemotePowerSpot</defName>
    <label>WD remote power spot</label>
    <description>Designates where power from World Domination power plant outposts enters your colony grid. Wire it into a power net (within conduit range). Relative share weights split that power among connected spots. Without a remote power spot, the colony won't receive any energy from power plant outposts.</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <selectable>true</selectable>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0.15</fillPercent>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <size>(1,1)</size>
    <statBases>
      <WorkToBuild>0</WorkToBuild>
    </statBases>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <designationCategory>Power</designationCategory>
    <drawGUIOverlay>true</drawGUIOverlay>
    <graphicData>
      <texPath>WorldObjects/Outposts/WD_Outpost_Powerplant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- Softened cyan (full Color.cyan was too loud on the colony map). -->
      <color>(0, 0.55, 0.55)</color>
    </graphicData>
    <building>
      <isEdifice>true</isEdifice>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <placeWorkers>
      <li>TSA_WorldDomination.PlaceWorker_WdColonyHomeOnly</li>
    </placeWorkers>
    <comps>
      <!-- Must be exact CompPowerTrader: ThingDef.ConnectToPower uses typeof equality (subclasses never connect / draw wire). -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>0</basePowerConsumption>
      </li>
      <li Class="TSA_WorldDomination.CompProperties_WdRemotePowerSpot" />
    </comps>
  </ThingDef>
</Defs>
