<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Pawns can walk through tank traps; raiders still smash them as nearby player buildings. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Vehicles Expanded</li>
    </mods>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="VVE_TankTrap"]/building</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VVE_TankTrap"]/building</xpath>
        <value>
          <ai_neverTrashThis>true</ai_neverTrashThis>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VVE_TankTrap"]</xpath>
        <value>
          <building>
            <ai_neverTrashThis>true</ai_neverTrashThis>
          </building>
        </value>
      </nomatch>
    </match>
  </Operation>
</Patch>
