<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
        <value>
            <li Class="TSA_WorldDomination.CompProperties_ViralSpread, TSA_WorldDomination" />
            <li Class="TSA_WorldDomination.CompProperties_PlayerDispatchMode, TSA_WorldDomination" />
        </value>
    </Operation>
    <!-- World map inspect tabs come from WorldObjectDef.inspectorTabs (see WorldTile_Productivity_InspectTab.xml). -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/WorldObjectDef[@Name="StaticWorldObjectBase"]/inspectorTabs</xpath>
        <value>
            <li>TSA_WorldDomination.WITab_Outpost_Stats, TSA_WorldDomination</li>
        </value>
    </Operation>
</Patch>