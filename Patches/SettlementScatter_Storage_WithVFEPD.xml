  <!-- VFEPD active: swap explicit WD box/cart scatter lines for VFE_PropCategory_Storage pool. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/KCSG.SettlementLayoutDef[defName="Player_Outpost"]</xpath>
    <value>
      <modExtensions>
        <li Class="TSA_WorldDomination.WdSettlementScatterPropsExtension">
          <scatterPropCategories>
            <li>VFE_PropCategory_Storage</li>
          </scatterPropCategories>
        </li>
      </modExtensions>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/KCSG.SettlementLayoutDef[defName="Player_Outpost"]/propsOptions/scatterPropsDefs/li[starts-with(text(),'TSA_WD_Box_') or starts-with(text(),'TSA_WD_Cart_')]</xpath>
  </Operation>
