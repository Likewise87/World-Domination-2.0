<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- RimWorld 1.7 / Waylith runs net10.0. 1.6 ships a frozen DLL under 1.6/Assemblies. -->
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Optimize>true</Optimize>
		<DebugType>portable</DebugType>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<!-- Game assemblies live at the RimWorld install root (no RimWorldWin64_Data/Managed). -->
		<RimWorldDir>C:\Steam\steamapps\common\RimWorld</RimWorldDir>
	</PropertyGroup>
	<ItemGroup>
	  <None Include="RaidLogic\Reinforcements_Physical.cs" />
	  <Compile Remove="WD_OverviewPages/**" />
	  <Compile Remove="docs/**" />
	  <Compile Remove="dev/**" />
	  <Compile Remove="Guardrails/**" />
	  <Compile Remove="obj/**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Compile against Harmony 3 to match RimWorld 1.7 Workshop brrainz.harmony (do not ship Harmony). -->
		<PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2">
			<ExcludeAssets>runtime</ExcludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<!-- Waylith redirects UnityEngine* → UnityStubs; Waylith.dll required for native APIs. -->
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Waylith">
			<HintPath>$(RimWorldDir)\Waylith.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="KCSG">
		  <HintPath>..\..\..\..\..\workshop\content\294100\2023507013\1.6\Assemblies\KCSG.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Outposts">
		  <HintPath>..\..\..\..\..\workshop\content\294100\2023507013\1.6\Assemblies\Outposts.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
</Project>
